# ============================================================================
# TERRAFORM GITIGNORE
# ============================================================================

# Local .terraform directories
.terraform/
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# Uncomment if using sensitive data in tfvars
# *.tfvars
# *.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan
tfplan
tfplan.*

# Ignore any generated outputs
outputs.json

# Ignore IDE specific files
.idea/
*.iml
.vscode/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore backup files
*.bak
*.backup
*~
